{
    # Locus Caddyfile — Template
    # Used by setup.sh which injects DOMAIN via heredoc substitution.
    # For manual deploy: sed -i 's/${DOMAIN}/your.domain.com/g' this file
    # rate_limit is configured per-handle below
}

${DOMAIN} {
    root * /var/www/html
    file_server

    # Security headers
    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
    }

    # Activation endpoint: 5 attempts per 10 min per IP
    handle /api/activate {
        rate_limit {
            zone activation {
                key {remote_host}
                events 5
                window 10m
            }
        }
        reverse_proxy 127.0.0.1:8090
    }

    # Heartbeat: 1 request per 10s per IP
    handle /api/heartbeat {
        rate_limit {
            zone heartbeat {
                key {remote_host}
                events 1
                window 10s
            }
        }
        reverse_proxy 127.0.0.1:8090
    }

    # ── Ordering matters. Read before editing ──
    #
    # Caddy evaluates `handle` blocks in file order and a request matches only
    # the FIRST one that fits. So every /api/admin/* route must appear BEFORE
    # the general /api/* block below, or the generic rate-limited proxy swallows
    # it. That is not theoretical: with /api/* first, release uploads were
    # proxied to PocketBase (which caps bodies at a few MB) and counted against
    # the 100-requests/10s general limit, so publishing a build failed at deploy
    # time rather than in CI. The same trap now applies to the fetch service.
    #
    # `/admin` (no trailing slash) is redirected via an explicit `route` +
    # matcher. An exact-path matcher inside `handle` proved unreliable here —
    # the handle_path file_server below won the match and the redirect never
    # fired, so a typed URL or bookmark 404'd.

    # Release publishing -> dedicated fetch service, NOT PocketBase.
    #
    # The console no longer uploads binaries; it asks the hub to pull them
    # straight from the GitHub Release for a version. The fetch service owns
    # /var/www/updates and returns the verified hashes.
    #
    # It sits at /api/admin/fetch-release, which is also where one-shot signed
    # trigger links land (they carry ?version&nonce&exp&sig). Both the POST from
    # the console and a GET on a link must reach the same handler.
    handle /api/admin/fetch-release {
        reverse_proxy 127.0.0.1:8091
    }

    # Mint a fresh one-shot trigger link.
    handle /api/admin/fetch-link {
        reverse_proxy 127.0.0.1:8091
    }

    # General API: 100 requests per 10s per IP
    handle /api/* {
        rate_limit {
            zone api_default {
                key {remote_host}
                events 100
                window 10s
            }
        }
        reverse_proxy 127.0.0.1:8090
    }

    # PocketBase admin UI (no rate limit)
    handle /_/* {
        reverse_proxy 127.0.0.1:8090
    }

    # Admin console (static SPA at /admin/)
    route /admin {
        redir /admin/ permanent
    }
    handle_path /admin/* {
        root * /var/www/admin
        header {
            # The console is an internal tool: never index, and never cache the
            # shell (so a redeploy is picked up immediately).
            X-Robots-Tag "noindex, nofollow"
            Cache-Control "no-cache"
            X-Content-Type-Options "nosniff"
            X-Frame-Options "DENY"
        }
        # SPA fallback: an unknown path under /admin/ serves index.html so a
        # refresh on a sub-view still loads the app.
        try_files {path} /index.html
        file_server
    }

    # Static files
    handle /update.json {
        file_server
    }

    # Release binaries for the auto-updater.
    #
    # Layout on disk: /var/www/updates/<version>/<filename>
    #   e.g. /var/www/updates/1.1.0/locus-linux-amd64
    #        /var/www/updates/1.1.0/locus-linux-amd64.sha256
    #
    # Notes:
    #   * `file_server` on a subtree requires an explicit root, otherwise it
    #     would fall back to the site root and 404.
    #   * Directory listings are DISABLED. Without this, an exposed directory
    #     lists every published build and its naming convention; there is no
    #     reason for a client to browse.
    #   * Binaries are content-addressed by version, so caching is safe and
    #     polite — but a short TTL keeps a mistaken publish recoverable.
    #   * No rate limit: these are large one-shot downloads, and throttling a
    #     student mid-update on school wifi is worse than the bandwidth cost.
    handle_path /updates/* {
        root * /var/www/updates
        header {
            Cache-Control "public, max-age=300"
            X-Content-Type-Options "nosniff"
        }
        # Directory listing is off by default in Caddy; do NOT add
        # `browse <arg>` — Caddy 2 parses that argument as a TEMPLATE FILE
        # path, so both `browse false` and `browse off` fail at request time
        # with HTTP 500 ("open off: no such file or directory").
        file_server
    }

    log {
        output file /var/log/caddy/access.log
        format json
    }

    tls {
        protocols tls1.2 tls1.3
        curves x25519 secp384r1
    }
}
