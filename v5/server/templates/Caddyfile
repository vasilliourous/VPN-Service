{
    # MyVPN Caddyfile — Template
    # REPLACE "YOUR_SERVER_DOMAIN" with your actual domain before deploying.
    # If using the automated setup (setup.sh), DOMAIN is injected automatically.
    #
    # Example with envsubst:
    #   envsubst '${DOMAIN}' < templates/Caddyfile > /etc/caddy/Caddyfile
    # rate_limit is configured per-handle below
}

YOUR_SERVER_DOMAIN {
    root * /var/www/html
    file_server

    # Security headers
    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
    }

    # Activation endpoint: 5 attempts per 10 min per IP
    handle /api/activate {
        rate_limit {
            zone activation {
                key {remote_host}
                events 5
                window 10m
            }
        }
        reverse_proxy 127.0.0.1:8090
    }

    # Heartbeat: 1 request per 10s per IP
    handle /api/heartbeat {
        rate_limit {
            zone heartbeat {
                key {remote_host}
                events 1
                window 10s
            }
        }
        reverse_proxy 127.0.0.1:8090
    }

    # General API: 100 requests per 10s per IP
    handle /api/* {
        rate_limit {
            zone api_default {
                key {remote_host}
                events 100
                window 10s
            }
        }
        reverse_proxy 127.0.0.1:8090
    }

    # PocketBase admin UI (no rate limit)
    handle /_/* {
        reverse_proxy 127.0.0.1:8090
    }

    # Static files
    handle /update.json {
        file_server
    }

    log {
        output file /var/log/caddy/access.log
        format json
    }

    tls {
        protocols tls1.2 tls1.3
        curves x25519 secp384r1
    }
}
