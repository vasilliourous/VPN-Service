{
    # MyVPN Caddyfile — Template
    # Used by setup.sh which injects DOMAIN via heredoc substitution.
    # For manual deploy: sed -i 's/${DOMAIN}/your.domain.com/g' this file
    # rate_limit is configured per-handle below
}

${DOMAIN} {
    root * /var/www/html
    file_server

    # Security headers
    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
    }

    # Activation endpoint: 5 attempts per 10 min per IP
    handle /api/activate {
        rate_limit {
            zone activation {
                key {remote_host}
                events 5
                window 10m
            }
        }
        reverse_proxy 127.0.0.1:8090
    }

    # Heartbeat: 1 request per 10s per IP
    handle /api/heartbeat {
        rate_limit {
            zone heartbeat {
                key {remote_host}
                events 1
                window 10s
            }
        }
        reverse_proxy 127.0.0.1:8090
    }

    # General API: 100 requests per 10s per IP
    handle /api/* {
        rate_limit {
            zone api_default {
                key {remote_host}
                events 100
                window 10s
            }
        }
        reverse_proxy 127.0.0.1:8090
    }

    # PocketBase admin UI (no rate limit)
    handle /_/* {
        reverse_proxy 127.0.0.1:8090
    }

    # Admin console (static SPA at /admin/)
    @admin_root path /admin
    redir @admin_root /admin/ permanent
    handle_path /admin/* {
        root * /var/www/admin
        header {
            X-Robots-Tag "noindex, nofollow"
            Cache-Control "no-cache"
            X-Content-Type-Options "nosniff"
            X-Frame-Options "DENY"
        }
        try_files {path} /index.html
        file_server
    }

    # Release uploads -> dedicated uploader (PocketBase caps bodies at a few MB)
    handle /api/admin/upload {
        reverse_proxy 127.0.0.1:8091
    }

    # Static files
    handle /update.json {
        file_server
    }

    # Release binaries for the auto-updater.
    #
    # Layout on disk: /var/www/updates/<version>/<filename>
    #   e.g. /var/www/updates/1.1.0/locus-linux-amd64
    #        /var/www/updates/1.1.0/locus-linux-amd64.sha256
    #
    # Notes:
    #   * `file_server` on a subtree requires an explicit root, otherwise it
    #     would fall back to the site root and 404.
    #   * Directory listings are DISABLED. Without this, an exposed directory
    #     lists every published build and its naming convention; there is no
    #     reason for a client to browse.
    #   * Binaries are content-addressed by version, so caching is safe and
    #     polite — but a short TTL keeps a mistaken publish recoverable.
    #   * No rate limit: these are large one-shot downloads, and throttling a
    #     student mid-update on school wifi is worse than the bandwidth cost.
    handle_path /updates/* {
        root * /var/www/updates
        header {
            Cache-Control "public, max-age=300"
            X-Content-Type-Options "nosniff"
        }
        # Directory listing is off by default in Caddy; do NOT add
        # `browse <arg>` — Caddy 2 parses that argument as a TEMPLATE FILE
        # path, so both `browse false` and `browse off` fail at request time
        # with HTTP 500 ("open off: no such file or directory").
        file_server
    }

    log {
        output file /var/log/caddy/access.log
        format json
    }

    tls {
        protocols tls1.2 tls1.3
        curves x25519 secp384r1
    }
}
