{
    # MyVPN Caddyfile — Template
    # Domain is injected by the setup script
    order rate_limit after basic_auth
}

${DOMAIN} {
    root * /var/www/html
    file_server

    # Security headers
    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
    }

    # Rate limiting — each zone has a single key
    # Activation: rate-limited by client IP (5 attempts per 10 min)
    # Heartbeat: rate-limited by client IP (1 per 10s)
    # Default: rate-limited by client IP (100 per 10s)
    rate_limit {
        zone activation_zone {
            key {remote_host}
            events 5
            window 10m
        }
        zone heartbeat_zone {
            key {remote_host}
            events 1
            window 10s
        }
        zone default {
            key {remote_host}
            events 100
            window 10s
        }
    }

    handle /api/* {
        reverse_proxy 127.0.0.1:8090
    }

    handle /api/heartbeat {
        reverse_proxy 127.0.0.1:8090
    }

    handle /_/* {
        reverse_proxy 127.0.0.1:8090
    }

    handle /update.json {
        file_server
    }

    log {
        output file /var/log/caddy/access.log
        format json
    }

    tls {
        protocols tls1.2 tls1.3
        curves x25519 secp384r1
    }
}
