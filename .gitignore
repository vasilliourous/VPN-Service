# MyVPN Root .gitignore

# Generated code files
*-codes.txt
*-cards.pdf

# Build artifacts
dist/
build/bin/
frontend/dist/
node_modules/
*.exe
*.zip
*.tar.gz

# OS junk
.DS_Store
Thumbs.db
*.swp
*.swo

# Diagnostic scratch (probe logs, one-off scripts)
diag/
whale.txt

# IDE
.idea/
.vscode/
*.iml

# Secrets (encrypted is fine; plaintext never)
.secrets.env
age-key.txt
