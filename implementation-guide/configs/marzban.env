# Marzban Environment Variables
# Copy to /opt/marzban/.env

UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000

# Admin credentials
SUDO_USERNAME=REPLACE_ME_ADMIN_USERNAME
SUDO_PASSWORD=REPLACE_ME_ADMIN_PASSWORD

# Database
SQLALCHEMY_DATABASE_URL=mysql+pymysql://marzban:REPLACE_ME_DB_PASS@mariadb:3306/marzban

# Xray integration
XRAY_EXECUTABLE_PATH=/usr/local/bin/xray
XRAY_ASSETS_PATH=/usr/local/share/xray
XRAY_CONFIG_PATH=/usr/local/etc/xray/config.json

# Subscription settings
XRAY_SUBSCRIPTION_URL_PREFIX=https://api.REPLACE_ME_DOMAIN:8444
SUB_UPDATE_INTERVAL=12

# TLS
UVICORN_SSL_CERTFILE=/var/lib/marzban/certs/fullchain.pem
UVICORN_SSL_KEYFILE=/var/lib/marzban/certs/privkey.pem

# Telegram bot (optional — for admin alerts)
# TELEGRAM_API_TOKEN=
# TELEGRAM_ADMIN_ID=

# Webhook (optional)
# WEBHOOK_ADDRESS=
# WEBHOOK_SECRET=
