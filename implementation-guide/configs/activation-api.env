# Activation API Environment Variables
# Source before running the API: source /opt/activation-api/.env

# Admin API key for generating codes & viewing stats
ADMIN_API_KEY=REPLACE_ME_GENERATE_64_CHAR_RANDOM_STRING

# Your domain
VPS_DOMAIN=REPLACE_ME_YOUR_DOMAIN

# Database URL (SQLite for simplicity, Postgres/MariaDB for scale)
DATABASE_URL=sqlite:////opt/activation-api/activation.db

# REALITY keys (must match Xray config)
REALITY_PUBLIC_KEY=REPLACE_ME_REALITY_PUBLIC_KEY
REALITY_SHORT_ID=REPLACE_ME_REALITY_SHORT_ID

# Hysteria2 Salamander password (must match Hysteria2 config)
SALAMANDER_PASSWORD=REPLACE_ME_SALAMANDER_PASSWORD

# Tier pricing (for revenue tracking)
LITE_PRICE=5
STANDARD_PRICE=9
PREMIUM_PRICE=10
